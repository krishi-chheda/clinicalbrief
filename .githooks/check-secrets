#!/bin/sh
# Secret scan (review N-01): fails if any file git would commit (tracked, or untracked and not
# ignored) contains a database URL with a real password, a Supabase secret key, or a private key.
# Placeholders like <db-password> or [YOUR-PASSWORD] are allowed. Never prints the secret itself.
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1
pattern='postgres(ql)?(\+[a-z0-9]+)?://[^:/[:space:]]+:[^@<[[:space:]]+@|sb_secret_[A-Za-z0-9_-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----'
hits=$(git ls-files -z --cached --others --exclude-standard | xargs -0 grep -IlE "$pattern" 2>/dev/null)
if [ -n "$hits" ]; then
    echo "[secrets] BLOCKED: possible secret in:"
    printf '  %s\n' $hits
    echo "[secrets] Replace it with a placeholder (real values belong only in git-ignored .env files)."
    exit 1
fi
echo "[secrets] OK"
