# Copy to .env and fill in. Never commit .env.

# Supabase > Project Settings > Database > Connection string > "Session pooler" (URI).
# Leave unset for local development: the backend then uses SQLite (clinicalbrief_dev.db).
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Supabase project URL. Used to fetch the public JWT signing keys (JWKS).
SUPABASE_URL=https://<project-ref>.supabase.co

# Only if the project still uses the LEGACY shared JWT secret (Settings > JWT Keys).
# Leave empty for projects on asymmetric signing keys.
JWT_SECRET=

CORS_ORIGINS=http://localhost:3000
USE_MOCK_MODELS=true

# Copilot local LLM (Ollama). Patient data never leaves the machine: only loopback URLs and
# locally-run models are accepted (Ollama "cloud" models are refused).
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3.5
